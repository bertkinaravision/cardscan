# Copy to .env.local for local development. On Vercel, set these in
# Project → Settings → Environment Variables. Never commit real values.

# --- Sign-in (Auth.js + Google) ---
AUTH_SECRET=                 # random string: `npx auth secret` or `openssl rand -base64 32`
AUTH_GOOGLE_ID=              # OAuth client ID (Google Cloud → APIs & Services → Credentials)
AUTH_GOOGLE_SECRET=          # OAuth client secret
ALLOWED_EMAILS=bert@example.com,preeti@example.com   # comma-separated; only these can sign in

# --- Google Sheet + Drive ---
GOOGLE_SERVICE_ACCOUNT_JSON= # the service account key file contents (raw JSON or base64)
SHEET_ID=                    # from the Sheet URL: docs.google.com/spreadsheets/d/<SHEET_ID>/edit
SHEET_TAB=Contacts           # optional; tab is created if missing
DRIVE_FOLDER_ID=             # from the folder URL: drive.google.com/drive/folders/<DRIVE_FOLDER_ID>
DRIVE_UPLOAD_MODE=user       # user = test phase (personal accounts); service_account = Workspace shared drive

# --- Vision model ---
LLM_PROVIDER=gemini          # gemini | anthropic | mock (mock = fake answer, no key needed)
LLM_MODEL=                   # optional; defaults: gemini-2.5-flash, claude-haiku-5-5
GEMINI_API_KEY=              # aistudio.google.com → Get API key
ANTHROPIC_API_KEY=           # platform.claude.com → API keys (only when LLM_PROVIDER=anthropic)
